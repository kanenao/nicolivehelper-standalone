{
  "name": "nicolivehelper-standalone",
  "productName": "NicoLive Helper Standalone",
  "version": "0.1.0-beta.27",
  "description": "NicoLive Helper Standalone Desktop Application",
  "main": "main.js",
  "author": "amano / komatti365",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "start:host": "electron . --host",
    "start:headless": "electron . --host --headless",
    "dist": "electron-builder --win nsis zip",
    "dist:installer": "electron-builder --win nsis",
    "dist:zip": "electron-builder --win zip"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "electron-updater": "^6.8.12"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.komatti365.nicolivehelper.standalone",
    "productName": "NicoLive Helper Standalone",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/icons/icon-256.png",
      "artifactName": "NicoLiveHelper-Standalone-v${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NicoLive Helper Standalone",
      "artifactName": "NicoLiveHelper-Standalone-v${version}-Setup.${ext}",
      "license": "installer-license.rtf",
      "language": "1041"
    },
    "files": [
      "main.js",
      "preload.js",
      "remoteServer.js",
      "src/**/*",
      "node_modules/**/*",
      "package.json",
      "installer-license.rtf"
    ],
    "publish": {
      "provider": "github",
      "owner": "kanenao",
      "repo": "nicolivehelper-standalone"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kanenao/nicolivehelper-standalone.git"
  }
}
